@using MacroPrep.Shared.Models.Recipes;
@using MacroPrep.Client.Shared;
@page "/recipe/new"



<PageTitle>New Recipe</PageTitle>

<div class="page-wrapper">
	<div class="content-container">
		<header class="page-header">
			<div class="header-text">
				<h1 class="page-title">Create a new Recipe</h1>
				<p>In this page you will be describing all the information about the recipe.</p>
			</div>
		</header>
		<div class="recipe-form-container">
			<form class="recipe-form">
    
				<div class="recipe-section section-one">
					<InputText @bind-Value="_recipe.Name" class="recipe-title" placeholder="Recipe Title"></InputText>
					<InputTextArea @bind-Value="_recipe.Description" @oninput="@(e => LimitText(e))" class="recipe-description" maxlength="250" placeholder="Recipe Description (optional)"></InputTextArea>
					<p class="recipe-description-length-control">@(_recipe.Description?.Length ?? 0) / 250</p> 

					<hr />
					
					<p></p>

					<h4>Details</h4>

					<div class="details-container servings-container">
						<label class="detail-label">Servings</label>
						<div class="serving-buttons">
							@foreach (var count in _predefinedServings)
							{
								<button type="button"
										class="serving-btn @(!_isOtherServingSelected && _recipe.Servings == count ? "active" : "")"
										@onclick="() => SelectServing(count)">
									@count
								</button>
							}
							<button type="button"
									class="serving-btn @(_isOtherServingSelected ? "active" : "")"
									@onclick="SelectOtherServing">
								Other
							</button>
						</div>

						@if (_isOtherServingSelected)
						{
							<div class="other-input-wrapper">
								<InputNumber @bind-Value="_recipe.Servings" class="detail-input other-servings-input" placeholder="Enter amount" />
							</div>
						}
					</div>

					<div class="details-container times-container">
						<div class="time-group">
							<label class="detail-label">Prep Time <span class="time-unit">(min)</span></label>
							<InputNumber @bind-Value="_recipe.PreparationTimeMinutes" class="detail-input time-input" />
						</div>
    
						<div class="time-group">
							<label class="detail-label">Cook Time <span class="time-unit">(min)</span></label>
							<InputNumber @bind-Value="_recipe.CookingTimeMinutes" class="detail-input time-input" />
						</div>
    
						<div class="time-group">
							<label class="detail-label">Rest Time <span class="time-unit">(min)</span></label>
							<InputNumber @bind-Value="_recipe.RestingTimeMinutes" class="detail-input time-input" />
						</div>
					</div>

				</div> 

				<hr />

				<div class="recipe-section section-two">
					<div class="add-item-row">
						<h4>Ingredients</h4>
						<button class="mp-btn mp-btn-primary btn-icon-only" @onclick="AddIngredient" @onclick:preventDefault>
							<i class="bi bi-plus-lg"></i>
						</button>



					</div>
					<div class="add-item-row">
						<h4 class="info-title">Instructions</h4>
						<button class="mp-btn mp-btn-primary btn-icon-only" @onclick="AddStep" @onclick:preventDefault>
							<i class="bi bi-plus-lg"></i>
						</button>

					</div>
				</div>

			</form>
		</div>

	</div>
</div>

@code {
	private const int _descriptionLengthLimit = 250;
	private RecipeDto _recipe = new RecipeDto();
	private List<RecipeIngredientDto> _ingredients = new List<RecipeIngredientDto>();

	// Servings Logic
	private int[] _predefinedServings = { 1, 2, 4, 6 };
	private bool _isOtherServingSelected = false;


	// public async ValueTask Dispose() { }


	private void Submit()
	{
		Console.WriteLine("Submiting Recipe Information");
	}

	private void AddIngredient()
	{

	}

	private void AddStep()
	{
		
	}



	// HELPER Functions
	private void LimitText(ChangeEventArgs e)
	{
		var value = e.Value?.ToString() ?? "";

		if (value.Length > _descriptionLengthLimit)
			value = value.Substring(0, _descriptionLengthLimit);

		_recipe.Description = value;
	}

	private void SelectServing(int count)
	{
		_isOtherServingSelected = false;
		_recipe.Servings = count;
	}

	private void SelectOtherServing()
	{
		_isOtherServingSelected = true;
	}

}