@using MacroPrep.Shared.Models.Recipes;

<div class="item-row @(_isGhostRow ? "ghost-row" : "active-row")">
	@if (!_isGhostRow && !IsCreator)
	{
		<div class="drag-handle">⁝⁝</div>
	}

    <div class="input-group" @onkeydown="HandleKeyDown">

        @* Name Input (Expands to fill remaining space) *@
        <InputText
               @bind-Value="Model.Name"
               @bind-Value:event="oninput"
               class="form-input"
               placeholder="@(_isGhostRow ? "Add ingredient..." : "Name")"
               />

        @* Quantity Input (Small) *@
        <InputNumber
               @bind-Value="Model.Amount"
               @bind-Value:event="oninput"
                class="form-input"
               placeholder="Qty"
               />

        @* Unit Input (Small) *@
        <InputText
               @bind-Value="Model.MeasuringUnit"
               @bind-Value:event="oninput"
                class="form-input"
               placeholder="Unit"
               />

        @*TODO: Add delete button*@
    </div>
</div>

@code {

    private bool _isGhostRow => Model.IsEmpty();

    [Parameter]
    public required RecipeIngredientDto Model { get; set; }

    [Parameter]
    public bool IsCreator { get; set; } = false;

    [Parameter]
    public EventCallback OnEnterPressed { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }


    // Handlers
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnEnterPressed.InvokeAsync();
    }
}