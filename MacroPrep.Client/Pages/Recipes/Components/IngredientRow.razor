@using MacroPrep.Shared.Models.Recipes;

<div class="item-row @(_isGhostRow ? "ghost-row" : "active-row")">
	@if (!_isGhostRow && !IsCreator)
	{
		<div class="drag-handle">⁝⁝</div>
	}

    <div class="input-group" @onkeydown="HandleKeyDown">

        @* Name Input (Expands to fill remaining space) *@
        <input type="text"
               class="input-name"
               placeholder="@(_isGhostRow ? "Add ingredient..." : "Name")"
               @bind="Ingredient.Name"
               @bind:event="oninput"/>

        @* Quantity Input (Small) *@
        <input type="text"
               class="input-qty"
               placeholder="Qty"
               @bind="Ingredient.Amount"
               @bind:event="oninput" />

        @* Unit Input (Small) *@
        <input type="text"
               class="input-unit"
               placeholder="Unit"
               @bind="Ingredient.MeasuringUnit"
               @bind:event="oninput"/>

        @*TODO: Add delete button*@
    </div>
</div>

@code {

    private bool _isGhostRow => Ingredient.IsEmpty();

    [Parameter]
    public required RecipeIngredientDto Ingredient { get; set; }

    [Parameter]
    public bool IsCreator { get; set; } = false;

    [Parameter]
    public EventCallback OnEnterPressed { get; set; }


    // Handlers
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnEnterPressed.InvokeAsync();
    }
}