@using MacroPrep.Shared.Models.Recipes;

<div class="item-row @(_isGhostRow ? "ghost-row" : "active-row")" data-sortable-item>

    <div class="drag-handle @(_isGhostRow ? "barely visible" : "visible")">⁝⁝</div>

    <div class="input-group">

        @* Name Input (Expands to fill remaining space) *@
        <InputText
               @bind-Value="Model.Name"
               @onkeydown="HandleKeyDown"
               class="form-input"
               placeholder="@(_isGhostRow ? "Add ingredient..." : "Name")"
               />

        @* Quantity Input (Small) *@
        <InputNumber
               @bind-Value="Model.Amount"
               @onkeydown="HandleKeyDown"
                class="form-input"
               placeholder="Qty"
               />

        @* Unit Input (Small) *@
        <InputText
               @bind-Value="Model.MeasuringUnit"
               @onkeydown="HandleKeyDown"
                class="form-input"
               placeholder="Unit"
               />
    </div>

    <button type="button" class="action-btn delete-btn" aria-label="Remove ingredient" @onclick="OnRemove">
        <svg style="width:20px; height:20px; scale:1.5;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
    </button>
</div>

@code {

    private bool _isGhostRow => Model.IsEmpty();

    [Parameter]
    public required RecipeIngredientDto Model { get; set; }

    [Parameter]
    public bool IsCreator { get; set; } = false;

    [Parameter]
    public EventCallback OnEnterPressed { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter]
    public EventCallback<RecipeIngredientDto> OnDragStart { get; set; }

    [Parameter]
    public EventCallback<RecipeIngredientDto> OnDrop { get; set; }

    // Handlers
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnEnterPressed.InvokeAsync();
    }

    // Drag Event Handlers
    private async Task HandleDragStart(DragEventArgs eventArgs) => await OnDragStart.InvokeAsync(Model);
    private async Task HandleDrop (DragEventArgs eventArgs) => await OnDrop.InvokeAsync(Model);
}