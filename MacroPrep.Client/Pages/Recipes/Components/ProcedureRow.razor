@using MacroPrep.Shared.Models.Recipes;

<div class="item-row @(_isGhostRow ? "ghost-row" : "active-row")">
    @if (!_isGhostRow && !IsCreator)
    {
        <div class="drag-handle">⁝⁝</div>
    }

    <div class="input-group">

        @* Name Input (Expands to fill remaining space) *@
        <input type="text"
               class="input-name"
               placeholder="@(_isGhostRow ? "Add procedure..." : "Name")"
               @bind="Model.MainInstruction"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown"/>

        @* Description Input (Small) *@
        <textarea class="input-description"
               placeholder="Description"
               @bind="Model.Description"
               @bind:event="oninput"/>

        @*TODO: Add delete button*@
        @*TODO: Make MainInstruction appear on top of the Description*@
    </div>
</div>

@code {

    private bool _isGhostRow => Model.IsEmpty();

    [Parameter]
    public required RecipeProcedureDto Model { get; set; }

    [Parameter]
    public bool IsCreator { get; set; } = false;

    [Parameter]
    public EventCallback OnEnterPressed { get; set; }
    
    [Parameter]
    public EventCallback OnRemove { get; set; }


    // Handlers
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnEnterPressed.InvokeAsync();
    }
}