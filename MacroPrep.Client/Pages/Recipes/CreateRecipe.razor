@page "/recipes/create"

@using MacroPrep.Client.Pages.Recipes.Components

<div class="page-wrapper">
    <div class="content-container">
        <div class="recipe-modal-card">

            @* Header *@
            <div class="rm-header">
                <div class="rm-titles">
                    <h1>New Recipe</h1>
                    <p>Add to KitchenSync</p>
                </div>
                <button type="button" class="rm-close-btn" aria-label="Close">
                    <svg style="width:24px; height:24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            @* Tab Navigation *@
            <div class="filter-group">
                @foreach (RecipeTab tab in Enum.GetValues(typeof(RecipeTab)))
                {
                    var currentTab = tab;
                    <button type="button"
                            @onclick="() => SetTab(currentTab)"
                            class="filter-chip @(ActiveTab == currentTab ? "active" : "")">
                        @currentTab
                    </button>
                }
            </div>

            @* Form Content *@
            <EditForm Model="FormModel" OnValidSubmit="HandleSubmit" class="rm-body">
                <DataAnnotationsValidator />

                @if (ActiveTab == RecipeTab.Details)
                {
                    @* Image Dropzone / Preview Container *@
                    <div class="rm-image-dropzone">
                        @if (!string.IsNullOrWhiteSpace(FormModel.PhotoUrl))
                        {
                            <img src="@FormModel.PhotoUrl" alt="Recipe Preview" class="rm-preview-img" />
                        }
                        else
                        {
                            <svg style="width:40px; height:40px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span>Add a photo URL below</span>
                        }
                    </div>

                    @* URL Input *@
                    <div class="rm-field-group">
                        <label for="photoUrl">Photo URL</label>
                        <InputText @bind-Value="FormModel.PhotoUrl" id="photoUrl" class="form-input" placeholder="https://..." />
                    </div>

                    @* Name Input *@
                    <div class="rm-field-group">
                        <label for="recipeName">Recipe Name <span class="required-mark">*</span></label>
                        <InputText @bind-Value="FormModel.Name" id="recipeName" class="form-input" placeholder="e.g. Creamy Garlic Pasta" />
                        <ValidationMessage For="() => FormModel.Name" style="color: var(--error-color); font-size: 0.75rem;" />
                    </div>

                    @* Category Select *@
                    <div class="rm-field-group">
                        <label for="category">Category</label>
                        <InputSelect @bind-Value="FormModel.Category" id="category" class="form-input">
                            <option value="Breakfast">Breakfast</option>
                            <option value="Lunch">Lunch</option>
                            <option value="Dinner">Dinner</option>
                            <option value="Snack">Snack</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                    </div>

                    @* Split Row: Cook Time & Servings *@
                    <div class="rm-row">
                        <div class="rm-field-group">
                            <label for="cookTime">Cook Time (min)</label>
                            <InputNumber @bind-Value="FormModel.CookTimeMinutes" id="cookTime" class="form-input" />
                        </div>

                        <div class="rm-field-group">
                            <label for="servings">Servings</label>
                            <InputNumber @bind-Value="FormModel.Servings" id="servings" class="form-input" />
                        </div>
                    </div>
                }
                else if (ActiveTab == RecipeTab.Ingredients)
                {
                    <div class="rm-list-container">
                        @foreach (var ingredient in FormModel.Ingredients)
                        {
                            <IngredientRow @key="ingredient.Id" 
                                           Model="ingredient" 
                                           OnRemove="() => RemoveIngredient(ingredient)"
                                           OnDragStart="HandleDragStart"
                                           OnDrop="HandleDrop" />
                        }
                        @if (!FormModel.Ingredients.Any())
                        {
                            <p class="empty-state">No ingredients added yet.</p>
                        }
                    </div>
                }
                else if (ActiveTab == RecipeTab.Steps)
                {
                    <div class="rm-list-container">
                        @foreach (var step in FormModel.Steps)
                        {
                            <ProcedureRow @key="step.Id" 
                                          Model="step" 
                                          OnRemove="() => RemoveStep(step)" />

                            if (step != FormModel.Steps.Last())
                            {
                                <hr />
                            }
                        }
                        @if (!FormModel.Steps.Any())
                        {
                            <p class="empty-state">No steps added yet.</p>
                        }
                    </div>
                }
                else if (ActiveTab == RecipeTab.Macros)
                {
                    <div class="rm-row">
                        <div class="rm-field-group">
                            <label for="calories">Calories (kcal)</label>
                            <InputNumber @bind-Value="FormModel.Macros.Calories" id="calories" class="form-input" />
                        </div>
                        <div class="rm-field-group">
                            <label for="protein">Protein (g)</label>
                            <InputNumber @bind-Value="FormModel.Macros.Protein" id="protein" class="form-input" />
                        </div>
                    </div>
                    <div class="rm-row">
                        <div class="rm-field-group">
                            <label for="carbs">Carbs (g)</label>
                            <InputNumber @bind-Value="FormModel.Macros.Carbs" id="carbs" class="form-input" />
                        </div>
                        <div class="rm-field-group">
                            <label for="fat">Fat (g)</label>
                            <InputNumber @bind-Value="FormModel.Macros.Fat" id="fat" class="form-input" />
                        </div>
                    </div>
                }

                @* Footer Actions *@
                <div class="rm-footer">
                    @if (ActiveTab == RecipeTab.Details || ActiveTab == RecipeTab.Macros)
                    {
                        <button type="button" class="mp-btn mp-btn-outline">Cancel</button>
                        <button type="submit" class="mp-btn mp-btn-primary" @onclick="HandleSubmit">Save Recipe</button>
                    }
                    else if (ActiveTab == RecipeTab.Ingredients)
                    {
                        <button type="button" class="mp-btn mp-btn-outline" @onclick="AddIngredient">+ Add Ingredient</button>
                    }
                    else if (ActiveTab == RecipeTab.Steps)
                    {
                        <button type="button" class="mp-btn mp-btn-outline" @onclick="AddStep">+ Add Step</button>
                    }
                </div>

            </EditForm>
        </div>
    </div>
</div>
