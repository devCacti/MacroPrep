@page "/pantry"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using MacroPrep.Client.Services
@using MacroPrep.Client.Services.Offline
@using MacroPrep.Shared.Models.ShoppingLists
@using MacroPrep.Shared.Enums.ShoppingLists
@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage
@inject ShoppingListsService OfflineService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>The Pantry</PageTitle>

<div class="page-wrapper">
    <div class="content-container">

        <header class="page-header">
            <div class="header-text">
                <h1 class="page-title">The Pantry</h1>
                <p class="page-subtitle">Manage your shopping lists</p>
            </div>
            <button class="mp-btn mp-btn-primary add-btn" @onclick="CreateNewList">
                <i class="bi bi-plus-lg"></i> New List
            </button>
        </header>

        @if (_pendingInvites.Any())
        {
            <div class="invites-container mp-card">
                <h3>New List Invitations</h3>
                @foreach (var invite in _pendingInvites)
                {
                    <div class="invite-row">
                        <span><strong>@invite.OwnerName</strong> invited you to <strong>@invite.ListName</strong></span>
                        <div class="actions">
                            <button class="mp-btn mp-btn-primary" @onclick="() => AcceptInvite(invite)">Accept</button>
                            <button class="mp-btn-outline-danger" @onclick="() => DeclineInvite(invite)">Decline</button>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="pantry-grid">
            @foreach (var vm in _viewModels)
            {
                var currentVm = vm;
                var isSettingsOpen = _settingsOpen.ContainsKey(currentVm.List.Id) && _settingsOpen[currentVm.List.Id];

                <div class="shopping-card">

                    @* --- HEADER --- *@
                    <div class="card-header-section @(currentVm.List.IsShared ? "shared-bg" : "")">
                        <div class="header-top">
                            @* Title Input *@
                                <input type="text" class="list-title-input"
                                       value="@currentVm.List.Name"
                                       disabled="@(currentVm.GetUserRole(_currentUserId) < MemberType.Editor)"
                                       @onchange="@(e => UpdateListTitle(currentVm.List, (string)e.Value!))" />

                                @* Display Owner Name in the corner *@
                            @* Shared Badge *@
                            @if (currentVm.List.IsShared)
                            {
                                <span class="badge-shared" title="Shared List">
                                    <i class="bi bi-people-fill"></i>By:
                                    <span class="owner-tag"> @(currentVm.IsOwner(_currentUserId) ? "You" : currentVm.List.OwnerName)</span>
                                </span>
                            }

                            @* Settings Toggle Button *@
                            <button class="icon-action-btn @(isSettingsOpen ? "active" : "")"
                                    @onclick="@(() => ToggleSettings(currentVm.List.Id))"
                                    title="List Settings">
                                <i class="bi bi-gear-fill"></i>
                            </button>
                        </div>

                        @* Progress Bar *@
                        @{
                            var total = currentVm.Items.Count;
                            var completed = currentVm.Items.Count(i => i.IsChecked);
                            var percent = total == 0 ? 0 : (int)((double)completed / total * 100);
                        }
                        <div class="progress-info">
                            <span class="progress-text">@completed of @total items completed</span>
                        </div>
                        <div class="progress-bar-track">
                            <div class="progress-bar-fill" style="width: @(percent)%"></div>
                        </div>
                    </div>

                    @* --- BODY (Items) --- *@
                    <div class="card-body">
                        @if (!isSettingsOpen)
                        {
                            @* Show Items only when settings are CLOSED (Optional preference, or show both) *@
                            <div class="items-list">
                                @foreach (var item in currentVm.Items)
                                {
                                    <label class="item-row">
                                        <input type="checkbox" checked="@item.IsChecked" class="custom-checkbox" disabled="@(currentVm.GetUserRole(_currentUserId) == MemberType.Viewer)"
                                               @onchange="@(e => ToggleItem(currentVm, item, (bool)e.Value!))" />
                                        <div class="item-details">
                                            <span class="item-name @(item.IsChecked ? "strikethrough" : "")">@item.Name</span>
                                            @if (item.Quantity > 1)
                                            {
                                                <span class="item-qty">x@(item.Quantity)</span>
                                            }
                                        </div>
                                        @if (currentVm.GetUserRole(_currentUserId) >= MemberType.Editor)
                                        {
                                            <button class="btn-delete-item" @onclick="@(() => DeleteItem(currentVm, item))">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        }
                                    </label>
                                }
                            </div>

                            <div class="add-item-row">
                                <input type="text" class="add-input" placeholder="Add item..."
                                       @bind="_newInputs[currentVm.List.Id]"
                                       @onkeyup="@(e => HandleKeyUp(e, currentVm))" />
                                <button class="mp-btn mp-btn-primary btn-icon-only" @onclick="@(() => AddItem(currentVm))">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            @* --- SETTINGS PANEL (Expanded) --- *@
                            <div class="settings-panel">
                                <h4 class="settings-title">List Settings</h4>

                                @* 1. Share Toggle *@
                                <div class="setting-row">
                                    <div class="setting-info">
                                        <span class="setting-label">Share List</span>
                                        <span class="setting-desc">Allow others to view and edit</span>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" checked="@currentVm.List.IsShared"
                                               @onchange="@(e => ToggleSharedStatus(currentVm, (bool)e.Value!))">
                                        <span class="slider"></span>
                                    </label>
                                </div>

                                @* 2. Member Management (Only if Shared) *@
                                @if (currentVm.List.IsShared && currentVm.GetUserRole(_currentUserId) >= MemberType.Master)
                                {
                                    <div class="members-section">
                                        <span class="setting-label">Members</span>

                                        @* Member Chips *@
                                        <div class="member-chips">
                                            @foreach (var member in (currentVm.List.Members ?? Array.Empty<ListMemberDto>()))
                                            {
                                                <div class="member-chip @(member.HasAccepted ? "accepted" : "pending")">
                                                    <span class="member-initial">@member.UserName[0]</span>
                                                    <span>@member.UserName</span>
                                                    @if (!member.HasAccepted)
                                                    {
                                                        <small>(Pending)</small>
                                                    }
                                                    @* Only Owners/Masters see the remove button *@
                                                    @if (currentVm.GetUserRole(_currentUserId) >= MemberType.Master)
                                                    {
                                                        <button class="remove-member-btn @(_currentUserId == member.UserId ? "disabled" : "")" @onclick="() => RemoveMember(currentVm, member)">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        @* Add Member Input *@
                                        <div class="add-member-row">
                                            <input type="text" class="add-input" placeholder="Enter username..."
                                                   @bind="_newMemberInputs[currentVm.List.Id]" />
                                            <button class="mp-btn mp-btn-secondary" @onclick="() => AddMember(currentVm)">
                                                Add
                                            </button>
                                        </div>
                                    </div>
                                }

                                <div class="settings-divider"></div>

                                @* 3. Danger Zone *@
                                @if (currentVm.IsOwner(_currentUserId))
                                {
                                    <button class="delete-list-btn-full" @onclick="@(() => DeleteListAsync(currentVm))">
                                        <i class="bi bi-trash"></i> Delete this List
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    public class ListViewModel
    {
        public ListDto List { get; set; } = new();
        public List<ListItemDto> Items { get; set; } = new();

        // Helper to check if current user is the owner
        public bool IsOwner(Guid currentUserId) => List.OwnerId == currentUserId;

        // Helper to get current user's role
        public MemberType GetUserRole(Guid currentUserId)
        {
            if (IsOwner(currentUserId)) return MemberType.Creator;
            var member = List.Members?.FirstOrDefault(m => m.Id == currentUserId);
            return member?.Type ?? MemberType.Viewer;
        }
    }

    public class InviteViewModel
    {
        public Guid ListId { get; set; }
        public string ListName { get; set; } = "";
        public Guid OwnerId { get; set; }
        public string OwnerName { get; set; } = "";
    }

    private Dictionary<Guid, string> _newInputs = new();
    private Dictionary<Guid, bool> _settingsOpen = new();
    private Dictionary<Guid, string> _newMemberInputs = new();
    private Guid _currentUserId = Guid.Empty;
    private List<InviteViewModel> _pendingInvites = new();

    private List<ListViewModel> _viewModels = new();
    private List<ListDto> ShoppingLists { get; set; } = new List<ListDto>();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;


        if (user.Identity?.IsAuthenticated == true)
        {
            var idClaim = user.FindFirst("sub")?.Value ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (Guid.TryParse(idClaim, out var parsedId))
                _currentUserId = parsedId;
        }

        if (_currentUserId == Guid.Empty)
        {
            // Force logout because there is something very wrong with the authentication state if we can't get a valid user ID
            await ForceLogout();
            return;
        }

        await OfflineService.InitializeAsync();

        var storedLists = await OfflineService.GetAllListsAsync(_currentUserId);

        foreach (var list in storedLists)
        {
            var items = await OfflineService.GetItemsAsync(list.Id);

            _viewModels.Add(new ListViewModel
            {
                List = list,
                Items = items
            });
            _newInputs[list.Id] = "";
            _newMemberInputs[list.Id] = "";
        }
    }

    private async Task ForceLogout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        ((CustomAuthStateProvider)AuthStateProvider).NotifyUserLogout();

        Nav.NavigateTo("/login");
    }

    private void ToggleSettings(Guid listId)
    {
        if (_settingsOpen.ContainsKey(listId))
        {
            _settingsOpen[listId] = !_settingsOpen[listId];
        }
        else
        {
            _settingsOpen[listId] = true;
        }
    }

    private async Task ToggleSharedStatus(ListViewModel vm, bool isShared)
    {
        vm.List.IsShared = isShared;
        // If turning off, you might want to clear members logic here
        await OfflineService.SaveListAsync(vm.List);
    }

    private async Task AddMember(ListViewModel vm)
    {
        var username = _newMemberInputs[vm.List.Id];
        if (string.IsNullOrWhiteSpace(username)) return;

        // In a real app, you'd call API to find User ID by Username here
        var newMember = new ListMemberDto
            {
                Id = Guid.NewGuid(), // Placeholder ID
                UserName = username
            };

        // Resize array (simplest way for fixed array in DTO)
        var membersList = vm.List.Members.ToList();
        membersList.Add(newMember);
        vm.List.Members = membersList.ToArray();

        _newMemberInputs[vm.List.Id] = ""; // Clear input
        await OfflineService.SaveListAsync(vm.List);
    }

    private async Task RemoveMember(ListViewModel vm, ListMemberDto member)
    {
        var membersList = vm.List.Members.ToList();
        membersList.Remove(member);
        vm.List.Members = membersList.ToArray();

        await OfflineService.SaveListAsync(vm.List);
    }

    private async Task CreateNewList()
    {
        var newList = new ListDto
        {
            Id = Guid.NewGuid(),
            OwnerId = _currentUserId,
            Members = Array.Empty<ListMemberDto>(),
            Name = "New List" + (_viewModels.Count + 1),
        };

        await OfflineService.SaveListAsync(newList);

        _viewModels.Insert(0, new ListViewModel { List = newList });
        _newInputs[newList.Id] = "";
        _newMemberInputs[newList.Id] = "";
    }

    private async Task UpdateListTitle(ListDto list, string newName)
    {
        if (string.IsNullOrWhiteSpace(newName)) return;

        list.Name = newName;
        await OfflineService.SaveListAsync(list);
    }

    private async Task DeleteListAsync(ListViewModel viewModel)
    {
        _viewModels.Remove(viewModel);
        await OfflineService.DeleteListAsync(viewModel.List.Id);
    }

    private async Task AddItem(ListViewModel viewModel)
    {
        if (!_newInputs.ContainsKey(viewModel.List.Id)) return;

        var newItemName = _newInputs[viewModel.List.Id].Trim();

        if (string.IsNullOrEmpty(newItemName)) return;

        var newItem = new ListItemDto
        {
            Id = Guid.NewGuid(),
            ListId = viewModel.List.Id,
            Name = newItemName,
            Quantity = 1,
            IsChecked = false,
        };

        await OfflineService.AddItemAsync(newItem);

        viewModel.Items.Add(newItem);
        _newInputs[viewModel.List.Id] = "";
    }

    private async Task DeleteItem(ListViewModel viewModel, ListItemDto item)
    {
        await OfflineService.DeleteItemAsync(item.Id);
        viewModel.Items.Remove(item);
    }

    private async Task ToggleItem(ListViewModel viewModel, ListItemDto item, bool isChecked)
    {
        item.IsChecked = isChecked;
        await OfflineService.AddItemAsync(item); // Using AddItemAsync to update the item since it checks for existing ID
    }

    // Method to accept Enter Key for adding items
    private async Task HandleKeyUp(KeyboardEventArgs e, ListViewModel viewModel)
    {
        if (e.Key == "Enter") await AddItem(viewModel);
    }
}