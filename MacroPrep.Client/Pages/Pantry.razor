@page "/pantry"

<PageTitle>The Pantry</PageTitle>

<div class="page-wrapper">
    <div class="content-container">

        @* Header Section *@
        <header class="page-header">
            <div class="header-text">
                <h1 class="page-title">The Pantry</h1>
                <p class="page-subtitle">Manage your shopping lists</p>
            </div>
            <button class="mp-btn mp-btn-primary add-btn">
                <i class="bi bi-plus-lg"></i> New List
            </button>
        </header>

        @* Lists Grid *@
        <div class="pantry-grid">
            @foreach (var list in ShoppingLists)
            {
                <div class="shopping-card">
                    @* Card Header: Apply 'shared-bg' class if the list is shared *@
                    <div class="card-header-section @(list.IsShared ? "shared-bg" : "")">
                        <div class="header-top">
                            <h3 class="list-title">@list.Title</h3>
                            @if (list.IsShared)
                            {
                                <span class="badge-shared"><i class="bi bi-people"></i> Shared</span>
                            }
                        </div>

                        <div class="progress-info">
                            <span class="progress-text">@list.CompletedCount of @list.Items.Count items completed</span>
                        </div>

                        <div class="progress-bar-track">
                            <div class="progress-bar-fill" style="width: @(list.ProgressPercentage)%"></div>
                        </div>

                        @if (list.IsShared)
                        {
                            <p class="shared-with">Shared with: @list.SharedWith</p>
                        }
                    </div>

                    @* List Items *@
                    <div class="card-body">
                        <div class="items-list">
                            @foreach (var item in list.Items)
                            {
                                <label class="item-row">
                                    <input type="checkbox" checked="@item.IsChecked" class="custom-checkbox"/>
                                    <div class="item-details">
                                        <span class="item-name @(item.IsChecked ? "strikethrough" : "")">@item.Name</span>
                                        <span class="item-qty">@item.Quantity</span>
                                    </div>
                                </label>
                            }
                        </div>

                        @* Add Item Input *@
                        <div class="add-item-row">
                            <input type="text" class="add-input" placeholder="Add item..." />
                            <button class="mp-btn mp-btn-primary btn-icon-only">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>

                        @* Card Footer *@
                        <div class="card-footer-action">
                            <button class="share-btn">
                                <i class="bi bi-share"></i> Share List
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</div>

