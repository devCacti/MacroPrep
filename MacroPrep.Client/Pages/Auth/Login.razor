@page "/auth/login"

@using MacroPrep.Shared.Models.Auth
@using MacroPrep.Client.Services
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@attribute [AllowAnonymous]

<div class="auth-layout">
    <div class="auth-container">
        <div class="auth-header">
            <h1 class="macroprep-title">MacroPrep</h1>
            <p class="page-subtitle">Welcome back! Please access your vault.</p>
        </div>

        <div class="mp-card auth-card">

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="error-banner">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    <span>@_errorMessage</span>
                </div>
            }

            <EditForm Model="_loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="form-label">Username or Email</label>
                    <InputText @bind-Value="_loginModel.UserNameOrEmail" class="form-input" placeholder="chef@macroprep.com" />
                    <ValidationMessage For="@(() => _loginModel.UserNameOrEmail)" />
                </div>

                <div class="form-group">
                    <label class="form-label">Password</label>
                    <InputText @bind-Value="_loginModel.Password" type="password" class="form-input" placeholder="••••••••" />
                    <ValidationMessage For="@(() => _loginModel.Password)" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="mp-btn mp-btn-primary full-width" disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <span>Unlocking...</span>
                        }
                        else
                        {
                            <span>Log In</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>

        <div class="auth-footer">
            <span>Don't have an account?</span>
            <a href="/auth/register" class="mp-link">Create one</a>
        </div>
    </div>
</div>

@code {
    private LoginRequest _loginModel = new();
    private string _errorMessage = "";
    private bool _isLoading = false;

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = "";

        try
        {
            var response = await Http.PostAsJsonAsync("/api/auth/login", _loginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

                // 1. Save the Token (CustomHttpHandler reads this!)
                await LocalStorage.SetItemAsync("authToken", result!.Token);

                // 2. Notify the AuthStateProvider (forces UI refresh with new auth state)
                ((CustomAuthStateProvider)AuthStateProvider).NotifyUserLogin(result.Token);

                // 3. Redirect to Dashboard - Can't happen without the previous step (No. 2)
                Nav.NavigateTo("/");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.MethodNotAllowed)
            {
                _errorMessage = "API Unreachable. Please try again later.";
            }
            else
            {
                _errorMessage = "Invalid credentials. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Server connection failed. Please try again later.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }
}