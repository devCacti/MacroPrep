@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

@* Component that will handle redirection logic*@
<AccessControl />

<div class="page">
    <AuthorizeView>
        <Authorized>
            @if (context.User.FindFirst("setup_completed")?.Value == "true")
            {
                <div class="sidebar">
                    <NavMenu /> 
                </div>
            }
        </Authorized>
    </AuthorizeView>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
